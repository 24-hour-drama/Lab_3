<Window x:Class="Forms1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forms1"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="900"
        Background="WhiteSmoke" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Стиль кнопок -->
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="#E6E6FA"/>
            <Setter Property="BorderBrush" Value="#3333FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#3333FF" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1.05" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1.05" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль элементов списка -->
        <Style x:Key="AnimatedItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F0F8FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3333FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.X"
                                                To="5" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.X"
                                                To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6FA"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3333FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль карточек -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3333FF" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вкладок -->
        <Style x:Key="AnimatedTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="6,6,6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b"
                        CornerRadius="8"
                        Background="#F0F8FF"
                        BorderBrush="#3333FF"
                        BorderThickness="2"
                        Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3333FF"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.15"/>
                            </Border.Effect>
                            <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Подсветка при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6FA"/>
                            </Trigger>

                            <!-- Активная вкладка -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6FA"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3333FF"
                                                  BlurRadius="14"
                                                  ShadowDepth="3"
                                                  Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон TabControl с линией-разделителем под вкладками -->
        <Style x:Key="AnimatedTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка вкладок -->
                            <TabPanel Grid.Row="0"
                              IsItemsHost="True"
                              Background="Transparent"
                              Margin="0,4,0,4"/>

                            <!-- Тонкая линия-разделитель -->
                            <Border Grid.Row="1"
                            Height="1"
                            Margin="0,4,0,10"
                            Background="#3333FF"
                            Opacity="0.35"/>

                            <!-- Содержимое выбранной вкладки -->
                            <ContentPresenter Grid.Row="2"
                                      ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <TabControl x:Name="MainTabs"
                    Style="{StaticResource AnimatedTabControl}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource AnimatedTabItem}"/>
            </TabControl.Resources>

            <!-- ======================= ВКЛАДКА 1: НОЧНИК ======================= -->
            <TabItem Header="Ночник">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--Верхний заголовок -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="5" Margin="0,0,0,10" Background="#E6E6FA"
                            Style="{StaticResource Card}">
                        <TextBlock Text="Ночник" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="Black"/>
                    </Border>

                    <!-- ЛЕВАЯ ПАНЕЛЬ -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                                Padding="5" Margin="0,0,0,5" Background="#E6E6FA"
                                Style="{StaticResource Card}">
                            <TextBlock Text="Операции" HorizontalAlignment="Center" FontSize="18"/>
                        </Border>

                        <ListBox x:Name="OperationsListBox" Grid.Row="1"
                                 BorderBrush="#3333FF" BorderThickness="2"
                                 Background="#F0F8FF"
                                 ItemContainerStyle="{StaticResource AnimatedItem}"
                                 SelectionChanged="OperationsListBox_SelectionChanged"/>
                    </Grid>

                    <!-- ПРАВАЯ ПАНЕЛЬ -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Карточка операции -->
                        <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                                Padding="5" Margin="0,0,0,5" Background="#E6E6FA"
                                Style="{StaticResource Card}">
                            <TextBlock Text="Карточка операции" HorizontalAlignment="Center" FontSize="18"/>
                        </Border>

                        <!-- label1 -->
                        <Border Grid.Row="1" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,5" Background="#F0F8FF"
                                CornerRadius="8">
                            <Label x:Name="label1" Content="" Padding="5" FontSize="14" />
                        </Border>

                        <!-- Параметры -->
                        <Border Grid.Row="2" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,5" Background="#E6E6FA"
                                CornerRadius="8">
                            <TextBlock Text="Параметры:" HorizontalAlignment="Center" Padding="5" FontSize="16"/>
                        </Border>

                        <!-- Область ввода параметров + кнопка Выполнить -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2" Background="#F0F8FF" Margin="0,0,0,10"
                                    CornerRadius="8">
                                <StackPanel x:Name="FuncControlsPanel"/>
                            </Border>

                            <Button Grid.Row="1" Content="Выполнить" Click="Run_Click" Width="120"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AnimatedButton}"/>
                        </Grid>

                        <!-- Блок Предусловие / Постусловие / Результат -->
                        <Grid Grid.Row="4" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ПРЕДУСЛОВИЕ -->
                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,5,2" Background="White">
                                <Label x:Name="labelPreconditionColor" Width="15" Height="15" Background="Gray" Margin="2"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1" Background="#E6E6FA" Margin="0,0,5,2" Padding="2">
                                <Label Content="Предусловие:" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,2" Padding="2">
                                <Label x:Name="labelPreconditionValue" Content="" VerticalAlignment="Center"/>
                            </Border>

                            <!-- ПОСТУСЛОВИЕ -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,5,2" Background="White">
                                <Label x:Name="labelPostconditionColor" Width="15" Height="15" Background="Gray" Margin="2"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1" Background="#E6E6FA" Margin="0,0,5,2" Padding="2">
                                <Label Content="Постусловие:" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,2" Padding="2">
                                <Label x:Name="labelPostconditionValue" Content="" VerticalAlignment="Center"/>
                            </Border>

                            <!-- РЕЗУЛЬТАТ -->
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1" Background="#E6E6FA" Margin="0,0,5,0" Padding="2">
                                <Label Content="Результат:" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="#3333FF" BorderThickness="1" Padding="2">
                                <Label x:Name="labelResult" Content="" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Кнопка Контракт -->
                        <Button Grid.Row="5" Content="Контракт" Click="Contract_Click" Width="120"
                                HorizontalAlignment="Right" Margin="0,0,0,5"
                                Style="{StaticResource AnimatedButton}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============== ВКЛАДКА 2: КОНСТРУКТОР ФРАГМЕНТА ============== -->
            <TabItem Header="Конструктор фрагмента">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Заголовок -->
                        <RowDefinition Height="Auto"/>
                        <!-- Пресеты и кнопки -->
                        <RowDefinition Height="Auto"/>
                        <!-- Цель и Код (в 2 столбика) -->
                        <RowDefinition Height="*"/>
                        <!-- Трейс -->
                        <RowDefinition Height="Auto"/>
                        <!-- Итоговое wp -->
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="5" Margin="0,0,0,10" Background="#E6E6FA"
                            Style="{StaticResource Card}">
                        <TextBlock Text="Конструктор фрагмента" HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="Bold"/>
                    </Border>

                    <!-- Кнопки + пресеты (ПЕРЕНЕСЕНЫ НАВЕРХ) -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="cmbPresets" Grid.Column="0" SelectionChanged="CmbPresets_SelectionChanged"
                                  Height="32" VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  BorderBrush="#3333FF">
                            <ComboBoxItem Content="— выбрать пресет —" Tag="None" IsSelected="True"/>
                        </ComboBox>

                        <Button x:Name="btnCalc" Grid.Column="1" Content="Рассчитать wp"
                                Click="CalcWp_Click" Margin="0,0,8,0"
                                Style="{StaticResource AnimatedButton}"/>

                        <Button x:Name="btnTriad" Grid.Column="2" Content="Показать триаду"
                                Click="ShowTriad_Click"
                                Style="{StaticResource AnimatedButton}"/>
                    </Grid>

                    <!-- Цель (Post) и Код фрагмента в 2 столбика -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Цель (Post) -->
                        <Border Grid.Column="0" BorderBrush="#3333FF" BorderThickness="1"
                                Padding="6" Margin="0,0,5,0" Background="#F0F8FF"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Цель (Post):" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtPost" Height="140"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderBrush="#3333FF" Background="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Код фрагмента -->
                        <Border Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1"
                                Padding="6" Margin="5,0,0,0" Background="#F0F8FF"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Код фрагмента:" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtCode" Height="140"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         BorderBrush="#3333FF" Background="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Трейс -->
                    <Border Grid.Row="3" BorderBrush="#3333FF" BorderThickness="1"
                            Margin="0,0,0,10" Background="#F0F8FF"
                            Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel x:Name="pnlTrace">
                                <TextBlock Text="Здесь появится пошаговый трейс..."
                                           Foreground="Gray" FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Итоговое wp -->
                    <Border Grid.Row="4" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="6" Background="#E6E6FA"
                            Style="{StaticResource Card}">

                        <!-- Общий ScrollViewer для всего блока -->
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                            <!-- Небольшой отступ справа, чтобы текст не прилипал к полосе прокрутки -->
                            <StackPanel Margin="0,0,5,0">

                                <TextBlock Text="Итоговое предусловие (wp):" FontSize="14" FontWeight="Bold"/>
                                <Label x:Name="lblWpResult" Content="—" FontSize="14" Padding="4"
                                    FontFamily="Consolas"/>

                                <TextBlock Text="Человеческим языком:" FontSize="14" FontWeight="Bold"
                                    Margin="0,4,0,0"/>
                                <TextBlock x:Name="lblWpHuman" Text="—" FontSize="14" Margin="4,2,4,2"
                                    TextWrapping="Wrap"/>

                                <TextBlock Text="Условия определённости:" FontSize="14" FontWeight="Bold"
                                    Margin="0,4,0,0"/>
                                <TextBlock x:Name="lblDefinedness" Text="—" FontSize="14" Margin="4,2,4,2"
                                    TextWrapping="Wrap"/>

                            </StackPanel>
                        </ScrollViewer>

                    </Border>
                </Grid>
            </TabItem>

            <!-- ============== ВКЛАДКА 3: ЦИКЛЫ ============== -->
            <TabItem Header="Циклы">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="5" Margin="0,0,0,10" Background="#E6E6FA"
                            Style="{StaticResource Card}">
                        <TextBlock Text="Анализ циклов прошивки ночника" HorizontalAlignment="Center"
                       FontSize="22" FontWeight="Bold"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Левая панель -->
                        <Grid Grid.Column="0" Margin="0,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Выбор режима -->
                                <RowDefinition Height="Auto"/> <!-- Генератор -->
                                <RowDefinition Height="*"/>    <!-- Таблица массива -->
                                <RowDefinition Height="Auto"/> <!-- Кнопки -->
                                <RowDefinition Height="Auto"/> <!-- Индикатор Post -->
                            </Grid.RowDefinitions>
                            
                            <!-- Выбор режима -->
                            <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="1" Padding="6" Margin="0,0,0,5" Background="#F0F8FF" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Режим анализа:" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbLoopMode" Height="30" BorderBrush="#3333FF">
                                        <ComboBoxItem Content="— выбрать режим —" Tag="None" IsSelected="True"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <!-- Генератор массива -->
                            <Border Grid.Row="1" BorderBrush="#3333FF" BorderThickness="1" Padding="6" Margin="0,0,0,5" Background="#F0F8FF" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Генератор массива показаний:" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="n:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="txtN" Grid.Column="1" Height="25" BorderBrush="#3333FF" Text="10"/>
                                        <TextBlock Grid.Column="2" Text="min:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                        <TextBox x:Name="txtMin" Grid.Column="3" Height="25" BorderBrush="#3333FF" Text="0"/>
                                        <TextBlock Grid.Column="4" Text="max:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                        <TextBox x:Name="txtMax" Grid.Column="5" Height="25" BorderBrush="#3333FF" Text="1000"/>
                                        <TextBlock Grid.Column="6" Text="T:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                        <TextBox x:Name="txtT" Grid.Column="7" Height="25" BorderBrush="#3333FF" Text="500"/>
                                        <Button Grid.Column="8" Content="Сгенерировать" Click="GenerateArray_Click" Margin="5,0,0,0" Style="{StaticResource AnimatedButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Таблица массива -->
                            <Border Grid.Row="2" BorderBrush="#3333FF" BorderThickness="1" Padding="2" Margin="0,0,0,5" Background="White" Style="{StaticResource Card}">
                                <DataGrid x:Name="dgArray" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                            BorderBrush="Transparent" Background="White" RowBackground="White" AlternatingRowBackground="#F0F8FF">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Индекс (i)" Binding="{Binding Index}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Значение (a[i])" Binding="{Binding Value, Mode=TwoWay}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <!-- Кнопки управления -->
                            <Grid Grid.Row="3" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▶ Пуск" Click="RunLoop_Click" Style="{StaticResource AnimatedButton}"/>
                                <Button Grid.Column="1" Content="⏭ Шаг" Click="StepLoop_Click" Margin="5,0" Style="{StaticResource AnimatedButton}"/>
                                <Button Grid.Column="2" Content="↺ Сброс" Click="ResetLoop_Click" Style="{StaticResource AnimatedButton}"/>
                            </Grid>
                            <!-- Индикатор Post -->
                            <Border Grid.Row="4" BorderBrush="#3333FF" BorderThickness="2" Padding="8" Background="#E6E6FA" Style="{StaticResource Card}">
                                <StackPanel Orientation="Horizontal">
                                    <Label x:Name="lblPostIndicator" Width="20" Height="20" Background="Gray" Margin="0,0,10,0"/>
                                    <TextBlock Text="Постусловие цикла:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPostStatus" Text=" — ожидание запуска" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Правая панель -->
                        <Grid Grid.Column="1" Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- БЛОК 1: Инвариант и вариант-функция -->
                            <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="1" Padding="8" 
                                    Margin="0,0,0,5" Background="#F0F8FF" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Инвариант и вариант-функция" FontSize="16" FontWeight="Bold" 
                                                Margin="0,0,0,8" HorizontalAlignment="Center"/>

                                    <TextBlock Text="Инвариант (словами):" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtInvHuman" Text="res хранит сумму элементов от 0 до j-1" 
                                                FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                    <TextBlock Text="Инвариант (формула):" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtInvFormula" Text="res = Σa[i] ∧ 0 ≤ j ≤ n" 
                                                FontSize="14" FontFamily="Consolas" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Label x:Name="lblInvBefore" Width="15" Height="15" Background="Gray" 
                                                     Margin="0,0,5,0"/>
                                            <TextBlock Text="Inv до шага" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Label x:Name="lblInvAfter" Width="15" Height="15" Background="Gray" 
                                                     Margin="0,0,5,0"/>
                                            <TextBlock Text="Inv после шага" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Вариант-функция t:" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtVariant" Text="t = n - j = 10" FontSize="14" 
                                                FontFamily="Consolas" Margin="0,0,0,4"/>
                                    <ProgressBar x:Name="pbVariant" Height="20" Minimum="0" Maximum="100" Value="100"/>
                                </StackPanel>
                            </Border>

                            <!-- БЛОК 2: Проверка сохранения (wp) -->
                            <Border Grid.Row="1" BorderBrush="#3333FF" BorderThickness="1" Padding="8" 
                                    Margin="0,0,0,5" Background="#F0F8FF" Style="{StaticResource Card}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Проверка сохранения инварианта" FontSize="16" FontWeight="Bold" 
                                                    Margin="0,0,0,8" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Формула:" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="(Inv ∧ B) ⇒ wp(S, Inv)" FontSize="16" FontFamily="Consolas" 
                                                    Foreground="#3333FF" Margin="0,0,0,8"/>

                                        <TextBlock Text="Разбор:" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtWpExplanation" 
                                                   Text="Если инвариант верен и условие цикла истинно, то после выполнения тела цикла инвариант останется верен." 
                                                   FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <TextBlock Text="Результат wp (из ЛР-2):" FontSize="12" FontWeight="Bold"/>
                                        <Border BorderBrush="#3333FF" BorderThickness="1" Background="White" 
                                                Padding="5" CornerRadius="4">
                                            <TextBlock x:Name="txtWpResult" 
                                                       Text="— нажмите 'Шаг' для вычисления —" 
                                                       FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- БЛОК 3: Итоговый результат проверки цикла (НОВОЕ) -->
                            <Border Grid.Row="2" BorderBrush="#3333FF" BorderThickness="2" Padding="8" 
                                        Background="#E6E6FA" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Итоговая проверка корректности цикла" FontSize="16" FontWeight="Bold" 
                                                Margin="0,0,0,8" HorizontalAlignment="Center"/>

                                    <!-- Условие 1: Инициализация -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblInitStatus" Grid.Column="0" Width="18" Height="18" 
                                                Background="Gray"  Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="1. Инициализация: Pre ⇒ Inv" 
                                                    FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtInitDetail" Grid.Column="2" Text="—" 
                                                    FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Условие 2: Сохранение -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblPresStatus" Grid.Column="0" Width="18" Height="18" 
                                                Background="Gray" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="2. Сохранение: (Inv ∧ B) ⇒ wp(S, Inv)" 
                                                    FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtPresDetail" Grid.Column="2" Text="—" 
                                                    FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Условие 3: Выход -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblExitStatus" Grid.Column="0" Width="18" Height="18" 
                                                    Background="Gray"  Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="3. Выход: (Inv ∧ ¬B) ⇒ Post" 
                                                    FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtExitDetail" Grid.Column="2" Text="—" 
                                                    FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Условие 4: Завершение -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblTermStatus" Grid.Column="0" Width="18" Height="18" 
                                                Background="Gray" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="4. Завершение: t ≥ 0 ∧ t' &lt; t" 
                                                    FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtTermDetail" Grid.Column="2" Text="—" 
                                                    FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Общий вердикт -->
                                    <Border BorderBrush="#3333FF" BorderThickness="1" Background="White" 
                                            Padding="6" CornerRadius="4" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Label x:Name="lblFinalVerdict" Width="22" Height="22" 
                                                    Background="Gray"  Margin="0,0,10,0"/>
                                            <TextBlock x:Name="txtFinalVerdict" 
                                                   Text="Цикл не проверен" 
                                                   FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                  
            </TabItem>

        </TabControl>
    </Grid>
</Window>